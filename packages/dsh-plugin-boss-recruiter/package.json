{
  "name": "dsh-plugin-boss-recruiter",
  "version": "0.2.2",
  "description": "Boss Zhipin Safari-native AI recruiting assistant plugin for DeepSeek Harness — native boss_* tools, human-approved outreach, bundled recruiting SOP skill, and embedded web workbench.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "boss-zhipin",
    "recruiting",
    "safari",
    "macos"
  ],
  "license": "GPL-3.0",
  "type": "module",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudo-zz/bosss.git",
    "directory": "packages/dsh-plugin-boss-recruiter"
  },
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./service": "./lib/service.js",
    "./tools": "./lib/tools.js",
    "./skill": "./lib/skill.js",
    "./web": "./lib/web.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "docs/*.md",
    "assets/**/*",
    "lib/**/*.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0",
    "@deepseek-ai/dsh-skill": ">=0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
