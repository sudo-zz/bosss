{
  "name": "@joohw/boss-cli",
  "version": "0.9.0",
  "description": "Boss直聘招聘助手（macOS Safari CLI 能力包 + 纯静态候选人展示工作台，专为 WorkBuddy 等桌面 Agent 设计）",
  "keywords": [
    "boss",
    "boss-cli",
    "boss直聘",
    "safari",
    "hr-automation",
    "recruitment-automation",
    "cli",
    "agent"
  ],
  "homepage": "https://boss-cli.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudo-zz/bosss.git"
  },
  "type": "module",
  "main": "dist/cli/index.js",
  "types": "dist/cli/index.d.ts",
  "bin": {
    "boss": "dist/cli/index.js",
    "boss-desk": "scripts/boss-desk.mjs"
  },
  "files": [
    "dist",
    "desk/dist",
    "desk/server",
    "scripts",
    "skills",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "npm run build && node dist/cli/index.js",
    "doctor": "node dist/cli/index.js doctor",
    "skill:sync": "bash skills/boss-safari-recruiter/scripts/bootstrap.sh .",
    "skill:export": "bash skills/boss-safari-recruiter/scripts/export_portable_kit.sh ./dist-bundle",
    "desk:build": "npm --prefix desk run build",
    "desk": "npm run build && npm --prefix desk run build && node scripts/boss-desk.mjs",
    "desk:serve": "node scripts/boss-desk.mjs --no-open",
    "desk:dev": "npm --prefix desk run dev",
    "release:pack": "node scripts/pack-release.mjs",
    "release:serve": "node scripts/serve-update.mjs",
    "data:build": "node web/build.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.3.3"
  },
  "license": "GPL-3.0"
}
